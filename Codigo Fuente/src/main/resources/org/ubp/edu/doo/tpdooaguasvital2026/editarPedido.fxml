<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="730.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.ubp.edu.doo.tpdooaguasvital2026.controladores.EditarPedidoController">
   <children>
      <Label layoutX="15.0" layoutY="12.0" text="REGISTRAR PEDIDO" style="-fx-font-size: 16; -fx-font-weight: bold;" />
      <Label layoutX="500.0" layoutY="16.0" text="Estado: PENDIENTE" style="-fx-text-fill: gray;" />

      <Label layoutX="20.0" layoutY="55.0" text="Fecha:" />
      <DatePicker fx:id="txtFecha" layoutX="80.0" layoutY="50.0" prefHeight="29.0" prefWidth="140.0" />

      <Label layoutX="250.0" layoutY="55.0" text="Operador:" />
      <ComboBox fx:id="cmbOperador" layoutX="320.0" layoutY="50.0" prefHeight="28.0" prefWidth="200.0" />

      <Label layoutX="20.0" layoutY="95.0" text="Cliente:" />
      <ComboBox fx:id="cmbCliente" layoutX="80.0" layoutY="90.0" prefHeight="28.0" prefWidth="280.0" />

      <Label layoutX="380.0" layoutY="95.0" text="Zona:" />
      <Label fx:id="lblZona" layoutX="420.0" layoutY="95.0" text="-" style="-fx-font-weight: bold;" />

      <Label layoutX="20.0" layoutY="135.0" text="Distribuidor:" />
      <ComboBox fx:id="cmbDistribuidor" layoutX="100.0" layoutY="130.0" prefHeight="28.0" prefWidth="280.0" />

      <Label layoutX="400.0" layoutY="135.0" text="Entrega estimada:" />
      <DatePicker fx:id="txtFechaEstimada" layoutX="510.0" layoutY="130.0" prefWidth="150.0" />

      <Separator layoutX="15.0" layoutY="170.0" prefWidth="700.0" />

      <Label layoutX="20.0" layoutY="185.0" text="Producto:" />
      <ComboBox fx:id="cmbProducto" layoutX="80.0" layoutY="180.0" onAction="#alCambiarProducto" prefHeight="28.0" prefWidth="250.0" />

      <Label layoutX="350.0" layoutY="185.0" text="Cant:" />
      <TextField fx:id="txtCantidad" layoutX="390.0" layoutY="180.0" prefHeight="27.0" prefWidth="60.0" />

      <Label layoutX="470.0" layoutY="185.0" text="Precio:" />
      <TextField fx:id="txtPrecio" editable="false" layoutX="520.0" layoutY="180.0" prefHeight="27.0" prefWidth="80.0" />

      <Button fx:id="btnAgregarItem" layoutX="615.0" layoutY="180.0" mnemonicParsing="false" onAction="#agregarItemDetalle" text="+">
         <effect><DropShadow /></effect>
      </Button>
      <Button fx:id="btnQuitarItem" layoutX="645.0" layoutY="180.0" mnemonicParsing="false" onAction="#quitarItemDetalle" text="X" textFill="RED" />

      <TableView fx:id="tableView" layoutX="14.0" layoutY="220.0" onMouseClicked="#obtenerDetallePedidoSeleccionado" prefHeight="165.0" prefWidth="700.0">
        <columns>
          <TableColumn prefWidth="250.0" text="Producto" />
          <TableColumn prefWidth="100.0" text="Cantidad" />
          <TableColumn prefWidth="120.0" text="Precio Unit." />
          <TableColumn prefWidth="120.0" text="Subtotal" />
        </columns>
      </TableView>

      <Label layoutX="400.0" layoutY="400.0" text="Total: $" />
      <TextField fx:id="txtTotal" editable="false" layoutX="450.0" layoutY="395.0" prefHeight="28.0" prefWidth="120.0" />

      <CheckBox fx:id="chkAcepta" layoutX="20.0" layoutY="400.0" mnemonicParsing="false" text="Acepto las condiciones del pedido" />

      <Button fx:id="btnLimpiar" layoutX="14.0" layoutY="500.0" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" />
      <Button fx:id="btnCerrarEditarPedido" layoutX="520.0" layoutY="500.0" mnemonicParsing="false" onAction="#cerrarVentana" text="Cerrar" />
      <Button fx:id="btnGuardar" layoutX="600.0" layoutY="500.0" mnemonicParsing="false" onAction="#guardarPedido" text="Confirmar Pedido" />

      <ProgressBar fx:id="progress" layoutX="100.0" layoutY="503.0" prefHeight="15.0" prefWidth="91.0" />
   </children>
</AnchorPane>
